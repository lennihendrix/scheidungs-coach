#!/bin/bash
# Auto-increment patch version in docs/version.json on every push

VERSION_FILE="docs/version.json"

if [ ! -f "$VERSION_FILE" ]; then
  echo '{ "version": "1.0.0" }' > "$VERSION_FILE"
fi

# Read current version
CURRENT=$(cat "$VERSION_FILE" | grep -o '"version": *"[^"]*"' | grep -o '[0-9]*\.[0-9]*\.[0-9]*')
MAJOR=$(echo $CURRENT | cut -d. -f1)
MINOR=$(echo $CURRENT | cut -d. -f2)
PATCH=$(echo $CURRENT | cut -d. -f3)

# Increment patch
NEW_PATCH=$((PATCH + 1))
NEW_VERSION="$MAJOR.$MINOR.$NEW_PATCH"

# Write new version
echo "{ \"version\": \"$NEW_VERSION\" }" > "$VERSION_FILE"

echo "🔖 Version bumped: $CURRENT → $NEW_VERSION"

# Stage and commit — included in THIS push
git add "$VERSION_FILE"
git commit -m "chore: bump version to $NEW_VERSION" --no-verify

# Amend the push ref so git sends this new commit too
# The pre-push hook receives remote refs on stdin; we just exit 0
# and git will push whatever HEAD points to (which now includes the bump commit)
exit 0
